# Prebuilt desktop binaries (large, rebuildable from src/)
/bin/
/bin64/
/bin_unix/
/sauerbraten.app/

# Large third-party map/asset packages (not versioned; source data for asset scoping in Phase 9)
/packages/

# Full-content beta build's bundled assets (~1GB, copied wholesale from
# /packages/ above for a "beta test with every map/song" build) --
# local-only build artifact by request, not versioned. The curated
# duel7-only subset this replaced WAS tracked; those paths are now
# untracked (see the accompanying `git rm --cached`) rather than
# deleted, since the full copy happens to still contain them.
/android/app/src/main/assets/packages/

# Desktop build artifacts
*.o
*.obj
*.gch
*.pdb
*.ilk
*.exe
*.a
*.so
*.dylib
/src/vcpp/Release64/
/src/vcpp/Debug64/
/src/vcpp/Release/
/src/vcpp/Debug/

# Scratch output from ad hoc desktop test runs (e.g. asset-dependency
# tracing to scope the Android assets/ bundle) -- not build inputs
/tmphome/
/stdout.txt
/stderr.txt
/screenshot.png

# Android / Gradle / NDK build outputs
android/**/build/
android/**/.cxx/
android/**/.gradle/
android/local.properties
android/**/*.apk
android/**/*.aab
android/**/obj/
android/**/libs/

